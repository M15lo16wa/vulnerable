<!DOCTYPE html>
<html>

<head>
  <title>Transfer Funds</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <div class="container">
    <h1>Transfer Funds</h1>
    <% if (error) { %>
      <p style="color: red;">
        <%= error %>
      </p>
      <% } %>
        <% if (success) { %>
          <p style="color: green;">
            <%= success %>
          </p>
          <% } %>
            <form method="POST" action="/montransfert">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
              <div>
                <label for="destinataire">Nom du destinataire :</label>
                <input type="text" id="destinataire" name="destinataire" required>
              </div>
              <div>
                <label for="montant">Montant :</label>
                <input type="number" id="montant" name="montant" min="1" step="1" required>
              </div>
              <button type="submit"
                style="margin-top: 1rem; padding: 0.5rem 1rem; background: #2ecc71; color: white; border: none;">Transférer</button>
            </form>
            <a href="/dashboard"
              style="display: inline-block; margin-top: 1rem; padding: 0.5rem 1rem; background: #95a5a6; color: white; text-decoration: none;">Back
              to Dashboard</a>
  </div>
</body>

</html>